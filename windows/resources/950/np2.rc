    MENUITEM "x2 size", IDM_SOFTKBD_X2
    MENUITEM "x3 size", IDM_SOFTKBD_X3
END

IDR_MAIN MENU
BEGIN
    POPUP "模擬(&E)"
    BEGIN
        MENUITEM "重設(&R)",                      IDM_RESET
        MENUITEM "暫停(&P)",                      IDM_PAUSE
        MENUITEM SEPARATOR
        MENUITEM "設定(&C)...",               IDM_CONFIG
        POPUP "變更 CPU 速度(&S)"
        BEGIN
            MENUITEM "&x2",      IDM_CHANGECLK_X2
            MENUITEM "&x8",      IDM_CHANGECLK_X8
            MENUITEM "&x16",     IDM_CHANGECLK_X16
            MENUITEM "&x30",     IDM_CHANGECLK_X30
            MENUITEM "&x42",     IDM_CHANGECLK_X42
            MENUITEM "&x52",     IDM_CHANGECLK_X52
            MENUITEM "&x62",     IDM_CHANGECLK_X62
            MENUITEM "還原(&R)", IDM_CHANGECLK_RESTORE
        END
        POPUP "變更模擬速度(&S)"
        BEGIN
            MENUITEM "&x0.5",        IDM_EMULSPEED_50
            MENUITEM "&x0.75",       IDM_EMULSPEED_75
            MENUITEM "&x1（正常）", IDM_EMULSPEED_100
            MENUITEM "&x1.5",        IDM_EMULSPEED_150
            MENUITEM "&x2",          IDM_EMULSPEED_200
            MENUITEM "&x4",          IDM_EMULSPEED_400
            MENUITEM "&x8",          IDM_EMULSPEED_800
        END
        POPUP "建立新磁碟(&N)"
        BEGIN
            MENUITEM "軟碟映像檔(&F)...",   IDM_NEWDISKFD
            MENUITEM "硬碟映像檔(&H)...",     IDM_NEWDISKHD
        END
        MENUITEM "字型(&F)...",                    IDM_CHANGEFONT
        MENUITEM SEPARATOR
        MENUITEM "載入 VM 設定(&O)...",          IDM_LOADVMCFG
        MENUITEM "儲存 VM 設定(&S)...",          IDM_SAVEVMCFG
        MENUITEM SEPARATOR
        MENUITEM "結束(&X)",                       IDM_EXIT
    END
    POPUP "畫面(&S)"
    BEGIN
        MENUITEM "視窗(&W)",                     IDM_WINDOW
        MENUITEM "全螢幕(&F)",                 IDM_FULLSCREEN
		//MENUITEM "還原視窗邊框(&R)",      IDM_RESTOREBORDER
        MENUITEM SEPARATOR
        MENUITEM "不旋轉(&M)",                     IDM_ROLNORMAL
        MENUITEM "左旋轉(&L)",               IDM_ROLLEFT
        MENUITEM "右旋轉(&R)",              IDM_ROLRIGHT
        MENUITEM SEPARATOR
        MENUITEM "垂直同步時繪圖(&D)",                 IDM_DISPSYNC
        MENUITEM "模擬多色調色盤(&P)",              IDM_RASTER
        MENUITEM SEPARATOR
        MENUITEM "CPU 無等待(&N)",                    IDM_NOWAIT
        MENUITEM "CPU 時脈穩定器(&C)",       IDM_CPUSTABILIZER
        MENUITEM "動態 CPU 時脈調整(&A)",	IDM_ASYNCCPU
        POPUP "動態 CPU 時脈優先順序(&P)"
        BEGIN
            MENUITEM "效能", IDM_ASYNCCPU_LEVEL_MAX
            MENUITEM "時序穩定性", IDM_ASYNCCPU_LEVEL_MIN
        END
        MENUITEM SEPARATOR
        //MENUITEM "&Auto frame",                 IDM_AUTOFPS
        MENUITEM "不跳格(&U)",                 IDM_60FPS
        MENUITEM "1/&2 畫格",                  IDM_30FPS
        MENUITEM "1/&3 畫格",                  IDM_20FPS
        MENUITEM "1/&4 畫格",                  IDM_15FPS
        MENUITEM SEPARATOR
        MENUITEM "螢幕選項(&S)...",           IDM_SCREENOPT
    END
    POPUP "裝置(&D)"
    BEGIN
        POPUP "鍵盤(&K)"
        BEGIN
            MENUITEM "實體鍵盤(&K)",                   IDM_KEY
            MENUITEM "遊戲手把-&1",                   IDM_JOY1
            MENUITEM "遊戲手把-&2",                   IDM_JOY2
            MENUITEM SEPARATOR
            MENUITEM "機械 &SHIFT 鍵",           IDM_XSHIFT
            MENUITEM "機械 &CTRL 鍵",            IDM_XCTRL
            MENUITEM "機械 &GRPH 鍵",            IDM_XGRPH
            MENUITEM SEPARATOR
            MENUITEM "傳送 Ctrl+Alt+Del",           IDM_SENDCAD
            MENUITEM "貼上剪貼簿文字",		IDM_COPYPASTE_PASTE
            MENUITEM SEPARATOR
