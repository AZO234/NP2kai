IDR_MAIN MENU
BEGIN
    POPUP "模拟(&E)"
    BEGIN
        MENUITEM "重置(&R)",                      IDM_RESET
        MENUITEM "暂停(&P)",                      IDM_PAUSE
        MENUITEM SEPARATOR
        MENUITEM "设置(&C)...",               IDM_CONFIG
        POPUP "变更 CPU 速度(&S)"
        BEGIN
            MENUITEM "&x2",      IDM_CHANGECLK_X2
            MENUITEM "&x8",      IDM_CHANGECLK_X8
            MENUITEM "&x16",     IDM_CHANGECLK_X16
            MENUITEM "&x30",     IDM_CHANGECLK_X30
            MENUITEM "&x42",     IDM_CHANGECLK_X42
            MENUITEM "&x52",     IDM_CHANGECLK_X52
            MENUITEM "&x62",     IDM_CHANGECLK_X62
            MENUITEM "还原(&R)", IDM_CHANGECLK_RESTORE
        END
        POPUP "变更模拟速度(&S)"
        BEGIN
            MENUITEM "&x0.5",        IDM_EMULSPEED_50
            MENUITEM "&x0.75",       IDM_EMULSPEED_75
            MENUITEM "&x1（正常）", IDM_EMULSPEED_100
            MENUITEM "&x1.5",        IDM_EMULSPEED_150
            MENUITEM "&x2",          IDM_EMULSPEED_200
            MENUITEM "&x4",          IDM_EMULSPEED_400
            MENUITEM "&x8",          IDM_EMULSPEED_800
        END
        POPUP "创建新磁盘(&N)"
        BEGIN
            MENUITEM "软盘镜像文件(&F)...",   IDM_NEWDISKFD
            MENUITEM "硬盘镜像文件(&H)...",     IDM_NEWDISKHD
        END
        MENUITEM "字体(&F)...",                    IDM_CHANGEFONT
        MENUITEM SEPARATOR
        MENUITEM "加载 VM 设置(&O)...",          IDM_LOADVMCFG
        MENUITEM "保存 VM 设置(&S)...",          IDM_SAVEVMCFG
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                       IDM_EXIT
    END
    POPUP "屏幕(&S)"
    BEGIN
        MENUITEM "窗口(&W)",                     IDM_WINDOW
        MENUITEM "全屏(&F)",                 IDM_FULLSCREEN
		//MENUITEM "还原窗口边框(&R)",      IDM_RESTOREBORDER
        MENUITEM SEPARATOR
        MENUITEM "不旋转(&M)",                     IDM_ROLNORMAL
        MENUITEM "左旋转(&L)",               IDM_ROLLEFT
        MENUITEM "右旋转(&R)",              IDM_ROLRIGHT
        MENUITEM SEPARATOR
        MENUITEM "垂直同步时绘图(&D)",                 IDM_DISPSYNC
        MENUITEM "模拟多色调色板(&P)",              IDM_RASTER
        MENUITEM SEPARATOR
        MENUITEM "CPU 无等待(&N)",                    IDM_NOWAIT
        MENUITEM "CPU 时钟稳定器(&C)",       IDM_CPUSTABILIZER
        MENUITEM "动态 CPU 时钟调整(&A)",	IDM_ASYNCCPU
        POPUP "动态 CPU 时钟优先级(&P)"
        BEGIN
            MENUITEM "性能", IDM_ASYNCCPU_LEVEL_MAX
            MENUITEM "时序稳定性", IDM_ASYNCCPU_LEVEL_MIN
