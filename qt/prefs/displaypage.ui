            <property name="alignment">
             <set>Qt::AlignRight|Qt::AlignVCenter</set>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="realPalGroup">
         <property name="title">
          <string>Real palettes adjust</string>
         </property>
         <layout class="QHBoxLayout" name="realPalLayout">
          <item>
           <widget class="QSlider" name="RPal_tim">
