        <property name="text">
         <string>Use the IDE &amp;BIOS</string>
        </property>
        <property name="toolTip">
         <string>Loads a real IDE BIOS (ide.rom, d8000.rom, bank3.bin or bios9821.rom) instead of the built-in one</string>
