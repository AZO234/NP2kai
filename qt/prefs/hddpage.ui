       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="AIDEBIOS">
        <property name="text">
         <string>Turn it off &amp;automatically for disks it cannot handle</string>
        </property>
        <property name="toolTip">
         <string>The real BIOS only knows hard disks with 8 heads and 17 sectors per track</string>
        </property>
       </widget>
      </item>
