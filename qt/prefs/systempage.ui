 <class>SystemPage</class>
 <widget class="QWidget" name="SystemPage">
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="archGroup">
     <property name="title">
      <string>Base architecture</string>
     </property>
