       <layout class="QHBoxLayout" name="mouseSpeedLayout">
        <item>
         <widget class="QSlider" name="Mouse_sp">
          <property name="toolTip">
           <string>How far the PC-98 mouse moves for a move of the host mouse; full speed follows the host pointer pixel for pixel</string>
