"DriveMode"=dword:00000000
"DriveLetter"="Z:"
"FallbackToAuto"=dword:00000001
"UseRealCapacity"=dword:00000000
"FakeCapacityMB"=dword:00000800
"FakeFreeMB"=dword:00000400

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\NetworkProvider\Order]
